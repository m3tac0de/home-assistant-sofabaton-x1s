<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sofabaton X-series IR Export Format for IrScrutinizer
  =====================================================

  Wire format (validated 2026-08-31 by a physically observed device
  response: a Samsung TV driven through an X1 hub; matches vendor-cloud
  command deploys fetched back from a hub):

    [0:2]   timing-section byte length, 2-byte BE uint
            (4 bytes per flash/gap timing word; terminator excluded)
    [2:6]   format field  00 00 00 00
    [6:8]   carrier frequency in Hz, 2-byte BE uint
    [8:]    alternating mark/space durations in microseconds, one 4-byte
            BE uint per <girr:flash>/<girr:gap>, walking each sequence in
            order (intro -> repeat -> ending), preserving whatever
            structure the Girr signal carries.
    [-4:]   terminator  00 00 00 00

  Each <girr:gap> at the end of the intro and end of the repeat naturally
  becomes the inter-burst gap (typically ~73ms for Denon). The exporter
  doesn't need to inject artificial trailer gaps; Girr already has them.

  CAUTION: the hub ACKs malformed bodies and then emits nothing, so a
  layout claim only counts as verified when the target device physically
  responds. Earlier revisions of this exporter emitted a different
  framing (fixed header 00 00 03 20 00 00 followed by a 4-byte BE
  carrier); under the real layout that declares a zero-length timing
  section and a 0 Hz carrier, and the hub accepted those payloads while
  emitting no IR. Payloads exported with the old framing must be
  re-exported.

  The live-validated reference implementation of this layout is
  build_raw_ir_blob_body in
  custom_components/sofabaton_x1s/lib/blob_decoders.py.

  Output is a hex string with spaces, ready to paste into the Sofabaton HA
  integration's command payload editor.

-->

<exportformats:exportformat xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:exportformats="http://www.harctoolbox.org/exportformats"
                            xsi:schemaLocation="http://www.harctoolbox.org/exportformats http://www.harctoolbox.org/schemas/exportformats.xsd"
                            name="Sofabaton X-series"
                            extension="sbx"
                            multiSignal="false"
                            simpleSequence="false">

    <exportformats:documentation>
        <div>
            Export format for the Sofabaton X-series hub family (X1/X1S/X2), suitable
            for injection via the <a href="https://github.com/m3tac0de/home-assistant-sofabaton-x1s/">Home Assistant integration</a>.

            The output is a single hex string (bytes separated by spaces) representing the
            Sofabaton-native IR blob. The signal's intro, repeat, and ending sequences are
            emitted in order, preserving the structure of the source signal (so e.g. a
            Denon "double-burst" code keeps both halves).

            Note: exports made with versions of this format that emitted the fixed
            header 00 00 03 20 00 00 used an incorrect byte layout; the hub accepts
            those payloads without error but emits no IR. Re-export affected commands.
        </div>
    </exportformats:documentation>

    <xsl:stylesheet xmlns:girr="http://www.harctoolbox.org/Girr"
                    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                    version="1.0">

        <xsl:output method="text"/>

        <!-- 4-byte format field between the declared length and the carrier.
             Vendor-cloud deploys carry zeros here, and zeros is the variant
             validated by a physical device response. Other observed values
             (e.g. 00 10 01 00 on a learned capture) change the length
             semantics and are not emitted. -->
        <xsl:param name="FORMAT">00 00 00 00</xsl:param>

        <!-- 4-byte terminator after the last timing word. Not counted in the
             declared timing-section length. -->
        <xsl:param name="TERMINATOR">00 00 00 00</xsl:param>

        <!-- Entry point: emit the first signal of the first command of the
             first remote in the Girr document. multiSignal=false means
             IrScrutinizer hands us exactly one command at a time. -->
        <xsl:template match="/girr:remotes">
            <xsl:apply-templates select="girr:remote[1]/girr:commandSet[1]/girr:command[1]/girr:raw[1]"/>
        </xsl:template>

        <xsl:template match="girr:raw">
            <!-- Every flash/gap in document order (intro -> repeat -> ending) -->
            <xsl:variable name="words" select="girr:intro/girr:flash | girr:intro/girr:gap
                                             | girr:repeat/girr:flash | girr:repeat/girr:gap
                                             | girr:ending/girr:flash | girr:ending/girr:gap"/>

            <!-- [0:2] timing-section byte length: 4 bytes per timing word,
                 terminator excluded -->
            <xsl:call-template name="sb-word16">
                <xsl:with-param name="value" select="4 * count($words)"/>
            </xsl:call-template>

            <!-- [2:6] format field -->
            <xsl:value-of select="$FORMAT"/>
            <xsl:text> </xsl:text>

            <!-- [6:8] carrier frequency in Hz, as one 2-byte BE word -->
            <xsl:call-template name="sb-word16">
                <xsl:with-param name="value" select="round(number(@frequency))"/>
            </xsl:call-template>

            <!-- [8:] timing words, in microseconds, as 4-byte BE words -->
            <xsl:apply-templates select="$words"/>

            <!-- Terminator -->
            <xsl:value-of select="$TERMINATOR"/>
            <xsl:text>&#10;</xsl:text>
        </xsl:template>

        <xsl:template match="girr:flash | girr:gap">
            <xsl:call-template name="sb-word">
                <xsl:with-param name="value" select="round(number(.))"/>
            </xsl:call-template>
        </xsl:template>

        <!-- Emit one 32-bit big-endian unsigned int as "XX XX XX XX " (note trailing space). -->
        <xsl:template name="sb-word">
            <xsl:param name="value"/>
            <xsl:call-template name="sb-byte">
                <xsl:with-param name="value" select="floor($value div 16777216)"/>
            </xsl:call-template>
            <xsl:text> </xsl:text>
            <xsl:call-template name="sb-byte">
                <xsl:with-param name="value" select="floor($value div 65536) mod 256"/>
            </xsl:call-template>
            <xsl:text> </xsl:text>
            <xsl:call-template name="sb-byte">
                <xsl:with-param name="value" select="floor($value div 256) mod 256"/>
            </xsl:call-template>
            <xsl:text> </xsl:text>
            <xsl:call-template name="sb-byte">
                <xsl:with-param name="value" select="$value mod 256"/>
            </xsl:call-template>
            <xsl:text> </xsl:text>
        </xsl:template>

        <!-- Emit one 16-bit big-endian unsigned int as "XX XX " (note trailing space). -->
        <xsl:template name="sb-word16">
            <xsl:param name="value"/>
            <xsl:call-template name="sb-byte">
                <xsl:with-param name="value" select="floor($value div 256) mod 256"/>
            </xsl:call-template>
            <xsl:text> </xsl:text>
            <xsl:call-template name="sb-byte">
                <xsl:with-param name="value" select="$value mod 256"/>
            </xsl:call-template>
            <xsl:text> </xsl:text>
        </xsl:template>

        <!-- Two lowercase hex digits with no separator. Sofabaton captures we've
             seen use lowercase; we match that. -->
        <xsl:template name="sb-byte">
            <xsl:param name="value"/>
            <xsl:variable name="hex-chars">0123456789abcdef</xsl:variable>
            <xsl:value-of select="substring($hex-chars, floor($value div 16) + 1, 1)"/>
            <xsl:value-of select="substring($hex-chars, ($value mod 16) + 1, 1)"/>
        </xsl:template>

        <!-- Suppress anything else in the Girr tree (ccf, parameters, etc.) -->
        <xsl:template match="girr:ccf"/>
        <xsl:template match="girr:parameters"/>

    </xsl:stylesheet>
</exportformats:exportformat>
