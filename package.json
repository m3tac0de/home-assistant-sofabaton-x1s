{
  "name": "x1s-hass-root",
  "private": true,
  "type": "module",
  "scripts": {
    "build:tools-card": "node ./scripts/build-tools-card.mjs",
    "build:remote-card": "node ./scripts/build-remote-card.mjs",
    "build:remote-web": "node ./scripts/build-remote-web.mjs",
    "build:remote-embed": "node ./scripts/build-remote-embed.mjs",
    "build:remote-web-assets": "node ./scripts/build-remote-web-assets.mjs",
    "build:server-panel": "node ./scripts/build-server-panel.mjs",
    "build:frontend": "npm run build:tools-card && npm run build:remote-card && npm run build:remote-web && npm run build:remote-embed && npm run build:server-panel",
    "build:tools-card-harness-site": "node ./scripts/build-tools-card-harness-site.mjs",
    "build:readme-remote-shot": "node ./scripts/build-readme-remote-shot.mjs",
    "build:readme-banner": "npm run build:readme-remote-shot && node ./scripts/build-readme-banner.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build:frontend-tests": "node ./scripts/build-frontend-tests.mjs",
    "test:frontend": "npm run build:frontend-tests && node --test tests/frontend-dist",
    "test:playwright": "playwright test",
    "test:playwright:tools": "npm run build:tools-card && playwright test tests/playwright/tools-card-editor.spec.js",
    "test:playwright:update": "playwright test --update-snapshots",
    "test:playwright:remote": "playwright test tests/playwright/remote-card.spec.js tests/playwright/remote-card-editor.spec.js",
    "test:playwright:web-remote": "npm run build:remote-web && playwright test tests/playwright/web-remote.spec.js",
    "test:playwright:server-panel": "npm run build:server-panel && playwright test tests/playwright/server-panel.spec.js",
    "fetch:ha-themes": "node ./scripts/fetch-ha-themes.mjs",
    "audit:contrast": "node ./scripts/audit-contrast.mjs"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.43",
    "esbuild": "^0.27.0",
    "lit": "^3.3.1",
    "typescript": "^5.9.3"
  }
}
